# ---------------------------------------------------------------------------
# Rush Republic Employee Management Portal - backend environment
# Copy to .env and fill in real values:  cp .env.example .env
# ---------------------------------------------------------------------------

# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=replace-with-a-50-char-random-string

# Never leave this True in production.
DEBUG=True

# Comma-separated hostnames Django will serve.
ALLOWED_HOSTS=localhost,127.0.0.1

# ---- PostgreSQL -----------------------------------------------------------
DB_NAME=rush_republic_final_db
DB_USER=rush_republic_user
DB_PASSWORD=replace-with-your-db-password
DB_HOST=127.0.0.1
DB_PORT=5432

# ---- CORS -----------------------------------------------------------------
# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
