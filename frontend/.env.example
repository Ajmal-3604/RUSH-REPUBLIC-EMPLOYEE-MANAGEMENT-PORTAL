# ---------------------------------------------------------------------------
# Rush Republic Employee Management Portal - frontend environment
# Copy to .env and fill in the real value:  cp .env.example .env
#
# Create React App bakes REACT_APP_* vars into the build at build time, not
# at runtime -- when deploying, set this in the hosting platform's build-time
# environment variables (not just on the running server) and rebuild.
# ---------------------------------------------------------------------------

# Local dev default (matches backend/.env.example's port): http://localhost:8001/api
# Production: your deployed backend's URL, e.g. https://rush-republic-api.onrender.com/api
REACT_APP_API_BASE_URL=your-backend-api-url
